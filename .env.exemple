# =============================================================================
# SAMA MAILLOT — modèle du fichier .env
#
# 1. Copier ce fichier sous le nom « .env » (à la racine du projet, à côté de celui-ci).
# 2. Adapter les valeurs à la machine.
# Le fichier .env contient des secrets : il ne doit JAMAIS être envoyé sur Git.
# Mise en production (valeurs pour la recette et le site public) : voir docs/MISE_EN_PRODUCTION.md.
# Format : NOM=valeur, sans espace autour du « = ». Les lignes commençant par # sont ignorées.
# =============================================================================

# Environnement : local (XAMPP, erreurs affichées), recette ou production (erreurs masquées)
APP_ENV=local

# Adresse du site, sans « / » final
APP_URL=http://localhost/sama-maillot

# Base de données MySQL / MariaDB (valeurs par défaut de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sama_maillot
DB_USER=root
DB_PASS=

# Vérification du téléphone des vendeurs par code SMS : 1 = activée, 0 = désactivée
# (à activer seulement quand un fournisseur SMS est branché)
VERIFICATION_SMS=0

# Clé de chiffrement (codes de livraison) : 32 octets en base64, propre à chaque serveur.
# Générer avec : php -r "echo base64_encode(random_bytes(32));"   — ne jamais la changer en production
# (les codes déjà chiffrés deviendraient illisibles).
CLE_CHIFFREMENT=

# --- SMS (§22) : laisser vide en local = SMS simulés et affichés à l'écran ---
# SMS_FOURNISSEUR=orange pour Orange SMS API (compte Orange Developer requis)
SMS_FOURNISSEUR=
# En-tête d'autorisation « Basic … » fourni par Orange, et numéro expéditeur du compte (+221…)
ORANGE_AUTORISATION=
ORANGE_EXPEDITEUR=

# --- E-mails (§22) : SMTP d'Infomaniak. Laisser SMTP_HOTE vide en local = e-mails simulés ---
SMTP_HOTE=
SMTP_PORT=465
SMTP_CHIFFREMENT=ssl
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=

# SMS : 0 = désactivés (toutes les notifications partent par e-mail), 1 = activés (fournisseur requis)
SMS_ACTIF=0

# --- Paiement en ligne (§13.3) ---
# simulateur = simulateur de TEST (refusé en production) ; vide = paiement à la livraison UNIQUEMENT
# (réglage actuel : le choix « Payer en ligne » n'apparaît nulle part).
# Un agrégateur réel (PayTech, PayDunya…) sera ajouté avec ses clés quand le compte marchand existera.
PAIEMENT_FOURNISSEUR=

# --- Connexion avec Google et Facebook (guide : docs/README_CONNEXION_SOCIALE.md) ---
# true = bouton affiché ; false (ou identifiants vides) = bouton masqué et pages en 404.
# Adresses de retour : laisser vide = adresse du site (APP_URL + /connexion/google-retour.php…).
# Elles doivent être IDENTIQUES à celles déclarées chez Google et chez Meta.
GOOGLE_ACTIF=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_URL_RETOUR=

FACEBOOK_ACTIF=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Version épinglée de l'API Graph (modifiable sans toucher au code)
FACEBOOK_VERSION_API=v21.0
FACEBOOK_URL_RETOUR=
